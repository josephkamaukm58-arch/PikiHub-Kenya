<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>PikiHub Kenya | Motorcycle Marketplace</title>
<meta name="description" content="PikiHub Kenya - Find new and used motorcycles across Kenya.">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f4f6f8;color:#17202a}
header{background:#101820;color:#fff;padding:16px 5%;display:flex;align-items:center;justify-content:space-between}
.logo{font-size:25px;font-weight:900}.logo span{color:#f5a400}
nav a{color:#fff;text-decoration:none;margin-left:18px;font-size:14px}
.hero{background:linear-gradient(135deg,#101820,#26384d);color:white;padding:55px 5%;text-align:center}
.hero h1{font-size:40px;margin-bottom:10px}
.hero p{color:#d8dee5;margin-bottom:25px}
.search{max-width:1050px;margin:auto;background:white;padding:15px;border-radius:14px;display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:8px}
.search input,.search select{padding:13px;border:1px solid #ddd;border-radius:8px}
button{border:0;border-radius:8px;padding:13px 18px;font-weight:bold;cursor:pointer}
.search button{background:#f5a400}
section{padding:42px 5%}
.heading{text-align:center;margin-bottom:25px}
.heading h2{font-size:29px}
.heading p{color:#6b7280;margin-top:7px}
.categories,.brands,.bikes,.services{display:grid;gap:16px}
.categories{grid-template-columns:repeat(4,1fr)}
.category,.brand,.service,.card{background:white;border-radius:14px;padding:22px;box-shadow:0 2px 12px #0000000c}
.category{text-align:center;cursor:pointer}
.category .icon{font-size:35px}
.category h3{margin:8px 0}
.brands{grid-template-columns:repeat(6,1fr)}
.brand{text-align:center;font-weight:bold}
.bikes{grid-template-columns:repeat(3,1fr)}
.card{padding:0;overflow:hidden}
.photo{height:190px;background:#e5e7eb;display:flex;align-items:center;justify-content:center;font-size:65px}
.info{padding:18px}
.info h3{margin-bottom:7px}
.meta{color:#6b7280;font-size:13px}
.price{font-size:21px;font-weight:800;margin:10px 0;color:#07884d}
.actions{display:flex;gap:8px}
.actions button{flex:1}
.primary{background:#f5a400}.dark{background:#101820;color:#fff}
.services{grid-template-columns:repeat(4,1fr)}
.service{background:#101820;color:#fff}
.service h3{margin:8px 0}
footer{background:#101820;color:#cbd5e1;text-align:center;padding:35px 5%}
@media(max-width:800px){
nav{display:none}
.hero h1{font-size:31px}
.search{grid-template-columns:1fr}
.categories,.services{grid-template-columns:repeat(2,1fr)}
.brands{grid-template-columns:repeat(3,1fr)}
.bikes{grid-template-columns:1fr}
}

/* PikiHub upgrade */
.upgrade-bar{display:flex;justify-content:space-between;align-items:center;gap:12px;max-width:1100px;margin:0 auto;padding:16px 5%}
.upgrade-btn{background:#07884d;color:white;border-radius:10px;padding:12px 18px;text-decoration:none;font-weight:800}
.count{max-width:1100px;margin:0 auto;padding:0 5% 15px;color:#6b7280;font-weight:bold}
.card{position:relative;transition:.2s}
.card:hover{transform:translateY(-3px)}
.fav{position:absolute;right:12px;top:12px;background:white!important;border-radius:50%!important;width:42px;height:42px;padding:0!important;font-size:20px;z-index:2}
.whatsapp{background:#07884d!important;color:#fff}
.sell-box{max-width:800px;margin:auto;background:white;padding:25px;border-radius:16px;box-shadow:0 2px 15px #00000012}
.sell-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.sell-grid input,.sell-grid select,.sell-grid textarea{width:100%;padding:13px;border:1px solid #ddd;border-radius:8px}
.sell-grid textarea{min-height:100px;grid-column:1/-1}
.sell-submit{background:#f5a400;width:100%;margin-top:12px}
.modal{display:none;position:fixed;inset:0;background:#0008;z-index:9999;padding:20px;align-items:center;justify-content:center}
.modal-box{background:white;border-radius:16px;max-width:500px;width:100%;padding:25px}
.close{float:right;background:#101820;color:white;padding:7px 12px}
@media(max-width:600px){.sell-grid{grid-template-columns:1fr}.sell-grid textarea{grid-column:auto}}
</style>
</head>

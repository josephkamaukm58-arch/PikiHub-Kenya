</div>
<div class="sell-box">
<form id="sellForm">
<div class="sell-grid">
<input id="sellerName" placeholder="Your name" required>
<input id="sellerPhone" placeholder="Phone number" required>
<input id="bikeName" placeholder="Motorcycle name e.g. Boxer 125" required>
<input id="bikePrice" type="number" placeholder="Price in KSh" required>
<select id="bikeBrand" required>
<option value="">Select brand</option>
<option>Bajaj</option><option>TVS</option><option>Honda</option>
<option>Yamaha</option><option>Haojue</option><option>Haojin</option>
<option>Hero</option><option>Kibo</option><option>Other</option>
</select>
<select id="bikeCondition" required>
<option value="">Condition</option><option>New</option><option>Used</option><option>Electric</option>
</select>
<input id="bikeLocation" placeholder="Location e.g. Nakuru" required>

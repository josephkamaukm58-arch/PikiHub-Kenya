<script>
const countBox=document.getElementById("resultCount");

function filterBikes(){
 const text=document.getElementById("search").value.toLowerCase();
 const brand=document.getElementById("brand").value;
 const condition=document.getElementById("condition").value;
 const selects=document.querySelectorAll(".search select");
 const location=selects[3] ? selects[3].value : "";

 let shown=0;
 document.querySelectorAll(".card").forEach(card=>{
   const name=(card.dataset.name||"").toLowerCase();
   const cardBrand=card.dataset.brand||"";
   const cardCondition=card.dataset.condition||"";
   const meta=(card.querySelector(".meta")?.textContent||"").toLowerCase();

   const matchText=!text||name.includes(text);
   const matchBrand=!brand||cardBrand===brand;
   const matchCondition=!condition||cardCondition===condition;
   const matchLocation=!location||location==="All Kenya"||meta.includes(location.toLowerCase());

   const show=matchText&&matchBrand&&matchCondition&&matchLocation;
   card.style.display=show?"block":"none";
   if(show) shown++;
 });
 countBox.textContent="Showing "+shown+" motorcycle"+(shown===1?"":"s");
 document.getElementById("bikes").scrollIntoView({behavior:"smooth"});
}

document.querySelectorAll(".search select").forEach(x=>x.addEventListener("change",filterBikes));
document.getElementById("search").addEventListener("input",filterBikes);

document.querySelectorAll(".card").forEach(card=>{
 const actions=card.querySelector(".actions");
 const name=card.dataset.name||"Motorcycle";
 const phone="254700000000";

 const fav=document.createElement("button");
 fav.className="fav";
 fav.innerHTML="♡";
 fav.onclick=()=>{
   fav.innerHTML=fav.innerHTML==="♡"?"♥":"♡";
 };
 card.appendChild(fav);

 const view=actions.querySelector(".primary");
 if(view){
   view.onclick=()=>{
     document.getElementById("modalTitle").textContent=name;
     document.getElementById("modalText").textContent=
       "Motorcycle: "+name+" | "+(card.querySelector(".meta")?.textContent||"Kenya")+
       ". Contact the seller for the current price and availability.";
     document.getElementById("bikeModal").style.display="flex";
   };
 }

 const wa=actions.querySelector(".dark");
 if(wa){
   wa.classList.add("whatsapp");
   wa.onclick=()=>{
     const msg=encodeURIComponent("Hello PikiHub, I am interested in "+name+". Is it still available?");
     window.open("https://wa.me/"+phone+"?text="+msg,"_blank");
   };
 }
});

function closeBike(){
 document.getElementById("bikeModal").style.display="none";
}

document.getElementById("sellForm").addEventListener("submit",function(e){
 e.preventDefault();
 const name=document.getElementById("bikeName").value;
 const price=document.getElementById("bikePrice").value;
 alert("Thank you! Your "+name+" listing has been prepared. Price: KSh "+Number(price).toLocaleString()+".");
 this.reset();
});

window.onclick=e=>{
 if(e.target===document.getElementById("bikeModal")) closeBike();
};
</script>

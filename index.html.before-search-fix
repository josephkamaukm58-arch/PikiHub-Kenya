<script>
function filterBikes(){
const text=document.getElementById("search").value.toLowerCase();
const brand=document.getElementById("brand").value;
const condition=document.getElementById("condition").value;
document.querySelectorAll(".card").forEach(card=>{
const matchText=card.dataset.name.toLowerCase().includes(text);
const matchBrand=!brand||card.dataset.brand===brand;
const matchCondition=!condition||card.dataset.condition===condition;
card.style.display=matchText&&matchBrand&&matchCondition?"block":"none";
});
}
</script>


<div class="upgrade-bar">
<strong>🏍️ Ready to sell your motorcycle?</strong>
